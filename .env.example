# === ОБЯЗАТЕЛЬНОЕ ===
DATABASE_URL=postgresql://user:password@host:5432/bidstage
SECRET_KEY=change_me_to_a_random_secret_64chars
PORT=5000
HOST=0.0.0.0
PUBLIC_BASE_URL=https://your-replit-app.replit.app

# === ДЕМО-РЕЖИМЫ (для теста без реальных API) ===
# Пропускать реальную проверку shara — любая ссылка пройдёт. На проде = 0.
VK_AUTO_VERIFY=0
# OTP-код для подтверждения ставки. На локалке = 1, на проде = 0.
BID_OTP_DISABLED=1
# Локально HTTPS-сертификат (на Replit не нужно — там HTTPS снаружи).
USE_HTTPS=0

# === VK OAuth (опционально) ===
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_SERVICE_TOKEN=
VK_REDIRECT_URI=https://your-replit-app.replit.app/auth/vk/callback

# === Платёжные провайдеры (опционально, без них работает demo-режим) ===
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
IDRAM_MERCHANT_ID=
IDRAM_SECRET=

# === Курсы валют (опционально, есть fallback) ===
EXCHANGERATE_API_KEY=
